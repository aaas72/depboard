{
  "name": "depboard",
  "version": "0.1.0",
  "description": "Discover what's hiding in your projects in 10 seconds.",
  "keywords": [
    "npm",
    "dependencies",
    "outdated",
    "vulnerabilities",
    "audit",
    "monorepo",
    "dashboard",
    "cli"
  ],
  "author": "Abdellah Sheikh",
  "homepage": "https://github.com/aaas72/depboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaas72/depboard.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/aaas72/depboard/issues",
  "license": "MIT",
  "type": "module",
  "bin": {
    "depboard": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"for (const f of ['README.md','LICENSE']) require('fs').copyFileSync('../../'+f,f)\""
  },
  "devDependencies": {
    "@depboard/server": "workspace:*",
    "@depboard/shared": "workspace:*",
    "@depboard/web": "workspace:*",
    "tsup": "^9.0.0"
  }
}
